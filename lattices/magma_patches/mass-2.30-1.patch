+  // k >= 1 (Washington, Introduction to Cyclotomic Fields, Thm. 4.2); it vanishes when
+  // chi_d(-1) <> (-1)^k.  This is exact for both parities of z.  Evaluating the L-series
+  // numerically instead (below) and recognising the value with BestApproximation can
+  // return a wrong rational, e.g. for d = -2127, z = -6.
+  if AbsoluteDegree(K) eq 2 and Relative then
+    // AbsoluteDiscriminant is |d|; chi_d needs the sign of d.
+    d:= AbsoluteDiscriminant(Integers(K)) * (IsTotallyReal(K) select 1 else -1);
+    chi:= KroneckerCharacter(d, Rationals());
+    if Evaluate(chi, -1) ne (-1)^k then return 0; end if;    // BernoulliNumber(k, chi) asserts this
+    return BernoulliNumber(k, chi) / -k;
+  end if;
