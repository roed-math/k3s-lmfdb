+function FormLess(x, y)
+   // lexicographic order on triples
+   for i in [1..3] do
+      if x[i] ne y[i] then return x[i] lt y[i]; end if;
+   end for;
+   return false;
+end function;
+
+function LeastForm(S)
+   m := S[1];
+   for x in S do
+      if FormLess(x, m) then m := x; end if;
+   end for;
+   return m;
+end function;
+
+function ProperClassKey(f)
+   // The least form, as a triple, in the cycle of reduced forms of the indefinite
+   // form f: a canonical representative of its proper equivalence class.
+   return LeastForm([ [ h[1], h[2], h[3] ] : h in ReductionOrbit(Reduction(f)) ]);
+end function;
+
+function IndefiniteGenusKeys(g, proper : Power := 2)
+   // The proper equivalence classes (if proper) or the GL_2(Z)-classes in the
+   // genus (Power = 2) or proper spinor genus (Power = 4) of the indefinite
+   // primitive form g, as canonical triples.
+   // ClassGroup(Q) is the class group in the wide sense, of index 2 in the group
+   // C of proper classes when the fundamental unit has norm +1; its elements then
+   // lift to two proper classes in different genera, so g*h(x) for x in 2*G need
+   // not lie in the genus of g.  Also, the forms g*h(x) are not reduced in any
+   // canonical way, so (a,|b|,c) does not identify a class with its mirror image.
+   // ReducedForms(Q) has one form in each proper class; the genus of g is g*C^2,
+   // and its proper spinor genus is g*C^4 (an element of the adelic spinor kernel
+   // of SO(V) = K^1 is v/vbar with N(v) a local square everywhere, hence the
+   // square of a norm-one idele).
+   Q := Parent(g);
+   keys := { ProperClassKey(g*f^Power) : f in ReducedForms(Q) };
+   if not proper then
+      // the mirror image (a,-b,c) of f is improperly equivalent to f
+      keys := { LeastForm([ k, ProperClassKey(Q ! [ k[1], -k[2], k[3] ]) ]) : k in keys };
+   end if;
+   return keys;
+end function;
