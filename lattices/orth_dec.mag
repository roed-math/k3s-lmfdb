Z := Integers();

// let's try to implement the same idea in Magma
// for some reason Magma's OrthogonalComplement only works for LatNF, not Lat
function orth_comp(rs,sub)
  Zk := RSpace(Z,Dimension(sub));
  tok := hom<rs->Zk|[[(x,y): y in Basis(sub)]: x in Basis(rs)]>;
  ker := Kernel(tok);
  // we already have the inclusion map
  return ker,RSpace(Z,Dimension(ker),GramMatrix(ker));
end function;

intrinsic OrthogonalComplementFaster(rs::ModTupRng, sub::ModTupRng) -> ModTupRng
{Return the orthogonal complement of the sublattice sub in the ambient space rs.}
    return orth_comp(rs, sub);
end intrinsic;

intrinsic OrthogonalComplementFaster(L::Lat, sub::Lat) -> Lat
{Return the orthogonal complement of the sublattice sub in L.}
    // Work in the coordinate space carrying L's Gram as its inner product, so the
    // complement is orthogonal with respect to L's inner product. (RSpace(L) uses
    // the standard inner product, and Basis(L) is a sequence, not a module.)
    rs := RSpace(Integers(), Degree(L), GramMatrix(L));
    subM := sub<rs | [rs ! Eltseq(b) : b in Basis(sub)]>;
    oc := orth_comp(rs, subM);
    return sub<L | [L ! Eltseq(w) : w in Basis(oc)]>;
end intrinsic;

// this is an example
// it decomposes into components of rank 5 and 2
// lat := LatticeWithGram(SymmetricMatrix([6,-9,16,-3,7,18,1,-2,-8,8,0,0,-7,4,4,1,-1,0,-2,0,2,-1,2,1,0,0,0,2]));

// improvement: if we have something of codimension 1 contained in a
// component that is not a component, then the lattice is indecomposable
// more generally, if our components add to codimension 1 but the saturation
// of their sum is not a component, the lattice is indecomposable

// this is much the same algorithm as in arXiv:0604320, by Hemkemeier-Vallentin
function orth_dec(lat: norm_bd := Infinity())
  if Rank(lat) eq 0 then return [lat]; end if;
  mat := GramMatrix(lat);
  dim := Rank(lat);
  lll,tolll := LLLGram(mat);
  lat_lll := LatticeWithGram(lll);
  bd := Min(Max(Diagonal(lll)),norm_bd);
  components := [];
  rs := RSpace(Z,dim,lll);
  done := false;
  ret_val := [lat]; // if we fail, we fail
  
  sub_rs := sub<rs|>;

  for l in [1..bd] do
    sv := [rs|x[1]: x in ShortVectors(lat_lll,l,l)];
    if #sv gt 0 then vprint Lattice, 1: "considering", #sv, "vectors of norm", l; end if;
    for v in sv do
      if v notin sub_rs then
        vprint Lattice, 2: "looking at vector", v;
        nonorth_comps := [x: x in components|exists{i: i in Basis(x)|(rs!v,i) ne 0}];
        vprint Lattice, 2: "found", #nonorth_comps, "nonorthogonal component"*(#nonorth_comps eq 1 select "" else "s");
        new_comp := sub<rs|nonorth_comps,v>;
        new_orth := orth_comp(rs,new_comp);
        // why doesn't Saturation give you a subspace of the same space?
        sat_comp := sub<rs|Basis(Saturation(new_comp))>;
        if sat_comp eq rs or (Rank(sat_comp) eq Rank(rs)-1 and sub<rs|new_orth,sat_comp> ne rs) then
          done := true; ret_val := [lat];/*[LatticeWithGram(GramMatrix(rs))];*/
          break l;
        end if; // done
        if sub<rs|new_orth,sat_comp> eq rs then
          // we have found a component; recursively find the rest
          vprint Lattice, 1: "%%% splitting into two factors";
          orth_lat := LatticeWithGram(GramMatrix(new_orth));
          orth_rs := RSpace(Z,Rank(new_orth),GramMatrix(new_orth));
          orth_comps := orth_dec(orth_lat:norm_bd := norm_bd);
          orth_comps_lll := Append([sub<lat_lll|[&+[v[i]*Basis(new_orth)[i]: i in [1..Dimension(orth_lat)]]: v in Basis(c)]>: c in orth_comps],sub<lat_lll|Basis(sat_comp)>);
          orth_comps_lat := [sub<lat|[lat|Vector(v)*tolll: v in Basis(c)]>: c in orth_comps_lll];
          assert forall{x: x,y in orth_comps_lat|x eq y or forall{a: a in Basis(x), b in Basis(y)|(a,b) eq 0}};
          assert sub<lat|orth_comps_lat> eq lat;
          done := true; ret_val := orth_comps_lat;
          break l;
        else
          vprint Lattice, 2: "combining", #nonorth_comps, "component"*(#nonorth_comps eq 1 select "" else "s"), "with a new one";
          components := Append([PowerStructure(ModTupRng)|x: x in components|x notin nonorth_comps],sat_comp);
          if &+[Rank(i): i in components] eq Rank(rs)-1 then
            vprint Lattice, 2: "examining a codimension 1 situation";
            sum_comps := sub<rs|components>;
            sat_sum_comps := sub<rs|Basis(Saturation(sum_comps))>;
            orth_sub := orth_comp(rs,sat_sum_comps);
            // can we do better than this?
            if sub<rs|sat_sum_comps,orth_sub> eq rs then
              // we have found a decomposition
              // unfortunately we need this silly PowerStructure, to stop
              // Magma from deciding that the dimension is part of the type
              ssc_lat := LatticeWithGram(GramMatrix(sat_sum_comps));
              od_ssc_lat := orth_dec(ssc_lat:norm_bd := norm_bd);
              // there is a bit too much back-and-forth here
              od_ssc := [PowerStructure(ModTupRng)|sub<rs|[&+[v[j]*Basis(sat_sum_comps)[j]: j in [1..Dimension(ssc_lat)]]: v in Basis(i)]>: i in od_ssc_lat];
              rso := sub<rs|orth_sub>;
              orth_comps_lll := Append(od_ssc,rso);
              orth_comps_lat := [sub<lat|[lat|Vector(v)*tolll: v in Basis(c)]>: c in orth_comps_lll];
              assert forall{i: a in Basis(i), b in Basis(j), i,j in orth_comps_lat|i eq j or (a,b) eq 0};
              done := true; ret_val := orth_comps_lat;
              break l;
            elif #components eq 1 then
              done := true; ret_val := [lat];
              break l;
            end if;
            // otherwise we can't conclude yet; maybe there are two D_8
            // components with an element of norm 4 bridging them
          end if;
          // sub_rs := sub<rs|Basis(Saturation(sub<rs|sub_rs,v>))>;
          sub_rs := sub<rs|sub_rs,v>;
          if sub_rs eq rs then
            orig_cps := [sub<lat|[v*Transpose(lll): v in Basis(r)]>: r in components];
            try grams := [GramMatrix(i): i in orig_cps]; catch e "failed on lattice", lat; error "foo"; end try;
            done := true; ret_val := orig_cps;
            break l;
          end if;
        end if;
      end if;
    end for;
  end for;

  if norm_bd ge Max(Diagonal(lll)) and not done then
    vprint Lattice, 2: "!!! failed to find orthogonal decomposition";
  end if;
  assert forall{x: x,y in ret_val|x eq y or forall{a: a in Basis(x), b in Basis(y)|(a,b) eq 0}};
  return ret_val;
end function;

intrinsic OrthogonalDecompositionFaster(lat::Lat : norm_bd := Infinity()) -> SeqEnum[Lat]
{Return the orthogonal decomposition of the lattice lat with norm bound norm_bd.}
    return orth_dec(lat: norm_bd := norm_bd);
end intrinsic;

function split_1(lat)
  sv := ShortVectors(lat,1,1);
  sub_1 := sub<lat|[x[1]: x in sv]>;
  assert IsIsomorphic(sub_1,StandardLattice(Dimension(sub_1)));
  rs := RSpace(Z,Dimension(lat),GramMatrix(lat));
  orth_1 := orth_comp(rs,sub<rs|[rs!Eltseq(i): i in Basis(sub_1)]>);
  orth_lat := sub<lat|[lat!Eltseq(i): i in Basis(orth_comp)]>;
  return orth_1, orth_lat;
end function;

// Root systems.  The root sublattice of a positive definite lattice L is spanned by
// its vectors of norm 1 and 2.  The norm-1 vectors span a copy of I_k = Z^k, which
// splits off L, and a norm-2 vector x outside it is orthogonal to it (if (x, e) = 1
// for a norm-1 vector e then x - e has norm 1, so x lies in it), so the root
// sublattice is I_k plus an orthogonal sum of irreducible ADE root lattices, uniquely.  A
// component is a tuple <type, n> with type one of "I", "A", "D", "E".
//
// String form (the root_sublattice column): components in the order I, A, D, E, by
// increasing n within a type, a multiplicity prefix when it exceeds 1, separated by
// single spaces -- "I4 A2 2E8".  The empty root system is "0" (the zero lattice),
// not "": Magma's Split drops empty fields, so an empty string would misalign every
// record read back with it.

ROOT_TYPES := ["I", "A", "D", "E"];

function root_components(R)
  // Normalise to a degree = rank lattice: R may be an embedded sublattice (e.g. a
  // rank-2 root system inside a rank-3 lattice), and orth_dec's LLL transform
  // produces rank-length coordinates that cannot coerce into a higher-degree
  // ambient.  The root system only depends on the isometry class.
  od := orth_dec(LatticeWithGram(GramMatrix(R)));
  comps := [];
  k := 0;   // number of norm-1 components, which together form I_k
  for rl in od do
    if Rank(rl) eq 0 then
      continue;
    elif Rank(rl) eq 1 and Determinant(rl) eq 1 then
      k +:= 1;
      continue;
    // An irreducible root lattice is determined by its rank and determinant.
    elif Rank(rl) in [6..8] and Determinant(rl) eq 9-Rank(rl) then
      c := <"E", Rank(rl)>;
    elif Rank(rl) ge 4 and Determinant(rl) eq 4 then
      c := <"D", Rank(rl)>;
    elif Determinant(rl) eq Rank(rl)+1 then
      c := <"A", Rank(rl)>;
    else
      error "unknown root lattice";
    end if;
    assert IsIsomorphic(rl, LatticeWithGram(CartanMatrix(Sprintf("%o%o", c[1], c[2]))));
    Append(~comps, c);
  end for;
  if k gt 0 then Append(~comps, <"I", k>); end if;
  return comps;
end function;

function root_type_index(t)
  i := Index(ROOT_TYPES, t);
  error if i eq 0, "unknown root system type", t;
  return i;
end function;

function root_components_to_string(comps)
  if #comps eq 0 then return "0"; end if;
  keys := Sort([<root_type_index(c[1]), c[2]> : c in comps]);
  parts := [];
  i := 1;
  while i le #keys do
    j := i;
    while j lt #keys and keys[j+1] eq keys[i] do j +:= 1; end while;
    mult := j - i + 1;
    Append(~parts, (mult gt 1 select IntegerToString(mult) else "")
                   cat ROOT_TYPES[keys[i][1]] cat IntegerToString(keys[i][2]));
    i := j + 1;
  end while;
  return Join(parts, " ");
end function;

intrinsic RootString(L::Lat : IsRootSystem := true) -> MonStgElt
{The root system of the positive definite lattice L (of L itself when IsRootSystem,
else of the sublattice spanned by its vectors of norm 1 and 2), as a string like
"I4 A2 2E8": components ordered I, A, D, E and by rank within a type, multiplicity
prefixes, and "0" for the empty root system.}
  if IsRootSystem then
    R := L;
  else
    sv := ShortVectors(L, 1, 2);
    R := sub<L | [x[1] : x in sv]>;
  end if;
  return root_components_to_string(root_components(R));
end intrinsic;

intrinsic ParseRootString(s::MonStgElt) -> SeqEnum
{The components of a root system string (see RootString) as tuples <type, n>, with
multiplicities expanded.  Only the canonical form RootString produces is accepted.}
  if s eq "0" then return []; end if;
  comps := [];
  for tok in Split(s, " ") do
    i := 1;
    while i le #tok and tok[i] in "0123456789" do i +:= 1; end while;
    require i le #tok and tok[i] in ROOT_TYPES and i lt #tok : "malformed root system string", s;
    mult := i gt 1 select StringToInteger(tok[1..i-1]) else 1;
    n := StringToInteger(tok[i+1..#tok]);
    require mult ge 1 and n ge 1 : "malformed root system string", s;
    comps cat:= [<tok[i], n> : j in [1..mult]];
  end for;
  require root_components_to_string(comps) eq s : "not a canonical root system string", s;
  return comps;
end intrinsic;

// Number of vectors of norm 1 or 2 in a component (2k^2 for I_k: 2k of norm 1 and
// 2k(k-1) of norm 2), and the sort key of a component, larger first.
function root_count(c)
  t, n := Explode(c);
  case t:
    when "I": return 2*n^2;
    when "A": return n*(n+1);
    when "D": return 2*n*(n-1);
    when "E": return [72, 126, 240][n-5];
  end case;
  error "unknown root system type", t;
end function;

function root_component_key(c)
  // number of roots, then rank, then type, packed into one integer
  return (root_count(c) * 2^20 + c[2]) * 8 + root_type_index(c[1]);
end function;

intrinsic RootCount(s::MonStgElt) -> RngIntElt
{The number of vectors of norm 1 or 2 in a lattice with root system s (see RootString).}
  return &+[Integers() | root_count(c) : c in ParseRootString(s)];
end intrinsic;

intrinsic CompareRootStrings(s1::MonStgElt, s2::MonStgElt) -> RngIntElt
{Negative if root system s1 sorts before s2, positive if after, 0 if they are equal.
Larger root systems first: more roots (vectors of norm 1 or 2), then larger rank,
then the components compared largest first, each by number of roots, rank and then
type (E, D, A, I).  This is a total order on root systems.}
  c1 := ParseRootString(s1);
  c2 := ParseRootString(s2);
  d := &+[Integers() | root_count(c) : c in c2] - &+[Integers() | root_count(c) : c in c1];
  if d ne 0 then return d; end if;
  d := &+[Integers() | c[2] : c in c2] - &+[Integers() | c[2] : c in c1];
  if d ne 0 then return d; end if;
  k1 := Reverse(Sort([root_component_key(c) : c in c1]));
  k2 := Reverse(Sort([root_component_key(c) : c in c2]));
  for i in [1..Minimum(#k1, #k2)] do
    if k1[i] ne k2[i] then return k2[i] - k1[i]; end if;
  end for;
  return #k2 - #k1;
end intrinsic;
